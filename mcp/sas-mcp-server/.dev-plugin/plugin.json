{
  "name": "sas-mcp-server",
  "description": "Execute SAS code and query Compute, CAS, and model APIs on SAS Viya via OAuth 2.0.",
  "license": "Apache-2.0",
  "mcpServers": {
    "sas-mcp-server": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "VIYA_ENDPOINT",
        "ghcr.io/sassoftware/sas-mcp-server:1.19.1"
      ]
    }
  }
}
