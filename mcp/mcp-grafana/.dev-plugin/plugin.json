{
  "name": "mcp-grafana",
  "description": "An MCP server giving access to Grafana dashboards, data and more.",
  "license": "Apache-2.0",
  "mcpServers": {
    "mcp-grafana": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "GRAFANA_URL",
        "docker.io/grafana/mcp-grafana:2.2.0"
      ]
    }
  }
}
