{
  "name": "open-health-sync-mcp",
  "description": "Read-only access to self-hosted health data: samples, sleep, workouts, nutrition, daily summaries.",
  "license": "AGPL-3.0",
  "mcpServers": {
    "open-health-sync": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "OHS_MCP_URL",
        "-e",
        "OHS_MCP_KEY",
        "ghcr.io/soma-intelligence/open-health-sync:0.2.0"
      ]
    }
  }
}
